name: Scope B CI

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  run-scope-b-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest

      - name: Run Scope B Tests Safely
        run: |
          # رفع حدود الـ memlock مؤقتاً لتجنب خطأ ENOMEM (12) عند تنفيذ mlockall
          ulimit -l unlimited || true
          pytest -v -s tests/scope_b/test_engine.py
