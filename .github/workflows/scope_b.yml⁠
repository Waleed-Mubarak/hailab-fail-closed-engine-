name: Scope B CI

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  run-scope-b-tests:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest

      - name: Run Scope B Tests as Root (for mlockall)
        run: |
          # تشغيل الاختبارات باستخدام sudo لمنح صلاحية CAP_IPC_LOCK وتجنب ENOMEM
          sudo -E pytest -v -s tests/scope_b/test_engine.py
