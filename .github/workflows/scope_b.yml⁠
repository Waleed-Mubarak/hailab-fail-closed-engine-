name: Scope B Audit CI

on:
  push:
    branches: [ "main" ] # أو تقييد الفروع حسب الرغبة
  pull_request:
    branches: [ "**" ]

jobs:
  scope-b-audit:
    runs-on: ubuntu-latest
    permissions:
      contents: read # تحقيق شرط القراءة فقط وعدم وجود صلاحيات كتابة/دفع
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest

      - name: Run Scope B Kernel Verification Tests
        run: |
          pytest tests/scope_b/
